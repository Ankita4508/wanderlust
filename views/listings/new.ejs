<% layout("layouts/boilerplate") %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3>Create a new listing</h3>
      <form
        action="/listings"
        method="POST"
        class="needs-validation"
        novalidate
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="title" class="form-lable">Title</label>
          <input
            type="text"
            name="listing[title]"
            placeholder="add a catchy title"
            class="form-control"
            id=""
            required
          />
          <div class="invalid-feedback">Please enter a valid title</div>
          <div class="valid-feedback">Title looks good!</div>
        </div>
        <div class="mb-3">
          <label for="discription" class="form-lable">Description</label>

          <textarea
            name="listing[description]"
            id=""
            class="form-control"
            required
          ></textarea>

          <div class="invalid-feedback">Please enter a description</div>
        </div>

        <div class="mb-3">
          <label for="image" class="form-lable">Upload Listing Image</label>
          <input
            type="file"
            name="listing[image]"
            class="form-control"
            id=""
            required
          />
        </div>

        <div class="mb-3">
          <select name="listing[category]" class="form-control">
            <option value="trending">Trending</option>
            <option value="rooms">Rooms</option>
            <option value="castles">Castles</option>
            <option value="trending">Iconic-Cities</option>
            <option value="rooms">Mountains</option>
            <option value="castles">Amazing-Pools</option>
            <option value="trending">Camping</option>
            <option value="rooms">Farms</option>
            <option value="castles">Artic</option>
            <option value="trending">Domes</option>
            <option value="rooms">Boats</option>
          </select>
        </div>


        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-lable">Price</label>
            <input
              type="number"
              name="listing[price]"
              placeholder="1200"
              class="form-control"
              id=""
              required
            />
            <div class="invalid-feedback">Please enter a valid Price</div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="country" class="form-lable">India</label>
            <input
              type="text"
              name="listing[country]"
              placeholder="entery country name"
              class="form-control"
              id=""
              required
            />
            <div class="invalid-feedback">
              Please enter a valid location
            </div>
          </div>
        </div>
        <div class="mb-3">
          <label for="location" class="form-lable">Location</label>
          <input
            type="text"
            name="listing[location]"
            placeholder="Enter Location"
            class="form-control"
            id=""
            required
          />
          <div class="invalid-feedback">Please enter a valid location</div>
        </div>
        <button class="btn add-btn btn-dark mt-3">Add</button>
        <br /><br />
      </form>
    </div>
  </div>
</body>
